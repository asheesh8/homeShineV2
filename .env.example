NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Field app sign-in (server-side only). Comma-separated username:password pairs
# for the staff in lib/simple-field.ts, e.g. "steven:<password>,beth:<password>".
FIELD_APP_USERS=
# Signs the session cookie. Generate with: openssl rand -hex 32
FIELD_SESSION_SECRET=
